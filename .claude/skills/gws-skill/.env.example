# Copy to .env and fill in. See references/setup-auth.md for where each value comes from.

# OAuth Desktop client (Cloud Console > Google Auth Platform > Clients > Desktop app)
GOOGLE_WORKSPACE_CLI_CLIENT_ID=
GOOGLE_WORKSPACE_CLI_CLIENT_SECRET=

# GCP project used for quota and billing
GOOGLE_WORKSPACE_PROJECT_ID=

# Default timezone for calendar helpers (used by the skill, not by gws itself)
GWS_TIMEZONE=Asia/Seoul
